PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Cloud Observability & 12-Factor Logging (Axiom Free Tier: 500GB/mo)
AXIOM_DATASET=job-processing-system
AXIOM_TOKEN=xaat-your-token-here

# API Key Authentication & RBAC Tiers
API_KEY_STANDARD=key_std_prod_123
API_KEY_VIP=key_vip_prod_456
API_KEY_ADMIN=key_admin_prod_789

# Queue Capacity & Backpressure Limits
MAX_QUEUE_CAPACITY=50
MAX_VIP_QUEUE_CAPACITY=100

